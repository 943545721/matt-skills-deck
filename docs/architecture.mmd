%% === 9 故障降级 ===
flowchart LR
    F1["gh 没登录"] --> R1["设备码流程<br/>token 只走 stdin"]
    F2["写请求 4xx（≠408）"] --> R2["回落 gh issue comment"]
    F3["5xx / 超时 / 断连"] --> R3["不回落、不重发<br/>报「先刷新确认」"]
    F4["GitLab 权限问不出"] --> R4["拒绝写"]
    F5["git ls-remote 超时"] --> R5["回落 gh 查 tag"]
    F6["多仓库没给 repoKey"] --> R6["拒绝猜，要求指明仓库"]
    F7["MCP 注入失败"] --> R7["记 warn，请求原样放行"]
    F8["子会话回传失败"] --> R8["记日志；回传件留在 .deck/handoffs"]
    F9["插件卸载"] --> R9["disposeGithubAuth 收掉 gh 子进程"]
